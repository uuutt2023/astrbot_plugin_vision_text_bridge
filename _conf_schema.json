{
  "MiniMax CLI": {
    "description": "MiniMax CLI",
    "type": "object",
    "hint": "mmx vision describe 认证与超时。",
    "items": {
      "minimax_api_key": {
        "description": "MiniMax API Key",
        "type": "string",
        "hint": "MiniMax 开放平台获取 sk- 开头的 Key。",
        "obvious_hint": true,
        "default": ""
      },
      "mmx_path": {
        "description": "mmx 路径",
        "type": "string",
        "hint": "留空自动从 PATH 查找。安装: npm install -g mmx-cli。",
        "default": ""
      },
      "auto_login": {
        "description": "自动登录 mmx",
        "type": "bool",
        "hint": "加载时用 minimax_api_key 执行 mmx auth login。",
        "default": true
      },
      "auto_install_cli": {
        "description": "自动安装 mmx-cli",
        "type": "bool",
        "hint": "找不到 mmx 时自动装到插件本地目录。需 Node.js/npm。",
        "default": true
      },
      "command_timeout": {
        "description": "单次超时（秒）",
        "type": "int",
        "hint": "通常 10-30 秒，大图建议调高。",
        "default": 60
      }
    }
  },
  "图像理解": {
    "description": "图像理解",
    "type": "object",
    "hint": "mmx 提示词与输出格式。",
    "items": {
      "vision_prompt": {
        "description": "视觉理解提示词",
        "type": "text",
        "hint": "要求 mmx 客观描述，严禁猜测游戏/角色名。",
        "default": "请客观描述图中可见的元素，列出主体人物/物品、场景背景、出现的文字（原文）、色调、风格。\n严禁猜测未明确显示的游戏/番剧/品牌/角色名称——如果不能从图中明确看出，请说'无法确定'。\n描述中只能包含你看到的事实，不要补充背景知识或推断。"
      },
      "max_description_length": {
        "description": "描述最大字符数",
        "type": "int",
        "hint": "超长截断省 token。0 = 不限制。",
        "default": 800
      },
      "strip_mmx_markdown": {
        "description": "清理 markdown 噪音",
        "type": "bool",
        "hint": "去掉加粗/列表前缀/多余空行，省 ~25% token。",
        "default": true
      }
    }
  },
  "并发": {
    "description": "并发",
    "type": "object",
    "hint": "单次请求内并行图片数。",
    "items": {
      "max_concurrent_vision": {
        "description": "最大并发数",
        "type": "int",
        "hint": "建议 1-4，避免 API 限流。",
        "default": 3
      }
    }
  },
  "OpenAI 兼容接口": {
    "description": "OpenAI 兼容接口",
    "type": "object",
    "hint": "暴露 /v1/chat/completions 并注册为 AstrBot provider。",
    "items": {
      "enabled": {
        "description": "启用接口",
        "type": "bool",
        "hint": "暴露 /v1/chat/completions 端点。",
        "default": true
      },
      "port": {
        "description": "监听端口",
        "type": "int",
        "hint": "独立 server 监听 127.0.0.1:<port>。",
        "default": 2023
      },
      "openapi_key": {
        "description": "OpenAPI 访问密钥",
        "type": "string",
        "default": "",
        "obvious_hint": true,
        "hint": "在 Dashboard「设置→OpenAPI」创建。X-API-Key 方式认证，优先级高于 webui_password。"
      },
      "webui_username": {
        "description": "Dashboard 用户名",
        "type": "string",
        "default": "admin",
        "hint": "默认 admin。"
      },
      "webui_password": {
        "description": "Dashboard 密码",
        "type": "string",
        "default": "",
        "hint": "用于 webui API 登录注册 provider。"
      },
      "auto_register": {
        "description": "自动注册",
        "type": "bool",
        "hint": "启动时注册到 provider_manager。",
        "default": true
      },
      "api_key": {
        "description": "端点 API Key（非 OpenAPI 密钥）",
        "type": "string",
        "hint": "本端点不校验，填 placeholder 即可。注册用 openapi_key 字段。",
        "default": "placeholder"
      },
      "model_name": {
        "description": "模型名称",
        "type": "string",
        "hint": "注册显示名，任意字符串。",
        "default": "vision-bridge"
      }
    }
  },
  "日志": {
    "description": "日志",
    "type": "object",
    "hint": "冗余日志开关，调试用。",
    "items": {
      "verbose_logging": {
        "description": "总开关",
        "type": "bool",
        "hint": "开启后所有细粒度开关生效。",
        "default": false
      },
      "verbose_mmx_subprocess": {
        "description": "mmx 子进程",
        "type": "bool",
        "hint": "完整命令行与 stdout/stderr。",
        "default": false
      }
    }
  },
  "脱敏": {
    "description": "脱敏",
    "type": "object",
    "hint": "日志敏感字段脱敏。",
    "items": {
      "redact_sensitive": {
        "description": "脱敏",
        "type": "bool",
        "hint": "关闭后日志输出完整 URL。",
        "default": true
      }
    }
  }
}
