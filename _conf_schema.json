{
  "API 密钥": {
    "description": "API 密钥",
    "type": "object",
    "hint": "首次使用第一步：配置两个 Key。MiniMax 用于图像理解，OpenAPI 用于注册 provider。",
    "items": {
      "minimax_api_key": {
        "description": "MiniMax API Key",
        "type": "string",
        "hint": "MiniMax 开放平台获取 sk- 开头的 Key，用于图像理解。",
        "obvious_hint": true,
        "default": ""
      },
      "openapi_key": {
        "description": "OpenAPI 访问密钥",
        "type": "string",
        "default": "",
        "obvious_hint": true,
        "hint": "在 Dashboard「设置→OpenAPI」创建 abk_ 开头的 Key，注册 provider 的唯一认证方式。"
      }
    }
  },
  "图像理解": {
    "description": "图像理解",
    "type": "object",
    "hint": "首次使用第二步：配置图像理解默认提示词与输出格式。",
    "items": {
      "vision_prompt": {
        "description": "视觉理解提示词",
        "type": "text",
        "hint": "传给 mmx 的默认提示词，调用方可覆盖。要求 mmx 客观描述，严禁猜测游戏/角色名。",
        "default": "请客观描述图中可见的元素，列出主体人物/物品、场景背景、出现的文字（原文）、色调、风格。\n严禁猜测未明确显示的游戏/番剧/品牌/角色名称——如果不能从图中明确看出，请说'无法确定'。\n描述中只能包含你看到的事实，不要补充背景知识或推断。"
      },
      "max_description_length": {
        "description": "描述最大字符数",
        "type": "int",
        "hint": "超长截断省 token。0 = 不限制。",
        "default": 800
      },
      "strip_mmx_markdown": {
        "description": "清理 markdown 噪音",
        "type": "bool",
        "hint": "去掉加粗/列表前缀/多余空行，省 ~25% token。",
        "default": true
      }
    }
  },
  "MiniMax CLI": {
    "description": "MiniMax CLI",
    "type": "object",
    "hint": "mmx CLI 路径与调用行为。",
    "items": {
      "mmx_path": {
        "description": "mmx 路径",
        "type": "string",
        "hint": "留空自动从 PATH 查找。安装: npm install -g mmx-cli。",
        "default": ""
      },
      "auto_login": {
        "description": "自动登录 mmx",
        "type": "bool",
        "hint": "加载时用 minimax_api_key 执行 mmx auth login。",
        "default": true
      },
      "auto_install_cli": {
        "description": "自动安装 mmx-cli",
        "type": "bool",
        "hint": "找不到 mmx 时自动装到插件本地目录。需 Node.js/npm。",
        "default": true
      },
      "command_timeout": {
        "description": "单次超时（秒）",
        "type": "int",
        "hint": "通常 10-30 秒，大图建议调高。",
        "default": 60
      }
    }
  },
  "并发": {
    "description": "并发",
    "type": "object",
    "hint": "单次请求内并行图片数。",
    "items": {
      "max_concurrent_vision": {
        "description": "最大并发数",
        "type": "int",
        "hint": "建议 1-4，避免 API 限流。",
        "default": 3
      }
    }
  },
  "OpenAI 兼容接口": {
    "description": "OpenAI 兼容接口",
    "type": "object",
    "hint": "暴露 /v1/chat/completions 并注册为 AstrBot provider。",
    "items": {
      "enabled": {
        "description": "启用接口",
        "type": "bool",
        "hint": "暴露 /v1/chat/completions 端点。",
        "default": true
      },
      "port": {
        "description": "监听端口",
        "type": "int",
        "hint": "独立 server 监听 127.0.0.1:<port>。",
        "default": 2023
      },
      "dashboard_port": {
        "description": "Dashboard 端口",
        "type": "int",
        "hint": "AstrBot Dashboard webui 监听端口，注册 provider 用。",
        "default": 6185
      },
      "register_max_attempts": {
        "description": "注册重试次数",
        "type": "int",
        "hint": "启动时 Dashboard 可能未就绪，每隔 5 秒重试一次。0 = 只试一次。",
        "default": 30
      },
      "auto_register": {
        "description": "自动注册",
        "type": "bool",
        "hint": "启动时注册到 provider_manager。",
        "default": true
      },
      "api_key": {
        "description": "端点 API Key",
        "type": "string",
        "hint": "调用方使用的占位 Key，本端点不校验。",
        "default": "placeholder"
      },
      "model_name": {
        "description": "模型名称",
        "type": "string",
        "hint": "注册显示名，任意字符串。",
        "default": "vision-bridge"
      }
    }
  },
  "日志": {
    "description": "日志",
    "type": "object",
    "hint": "冗余日志开关，调试用。",
    "items": {
      "verbose_logging": {
        "description": "总开关",
        "type": "bool",
        "hint": "开启后所有细粒度开关生效。",
        "default": false
      },
      "verbose_mmx_subprocess": {
        "description": "mmx 子进程",
        "type": "bool",
        "hint": "完整命令行与 stdout/stderr。",
        "default": false
      }
    }
  },
  "脱敏": {
    "description": "脱敏",
    "type": "object",
    "hint": "日志敏感字段脱敏。",
    "items": {
      "redact_sensitive": {
        "description": "脱敏",
        "type": "bool",
        "hint": "关闭后日志输出完整 URL。",
        "default": true
      }
    }
  }
}
